  "info": {
    "description": "Generated from the typed route table in packages/domain/src/api-routes.ts by `pnpm api:spec`. Do not edit by hand.",
    "title": "Baseball Theater API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/games/{gamePk}": {
      "get": {
        "operationId": "getGame",
        "parameters": [
          {
            "description": "MLB game id.",
            "in": "path",
            "name": "gamePk",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "description": "`1` forces an upstream refresh instead of serving the stored copy.",
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": { "enum": ["1"], "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GameSnapshotResponse" }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            },
            "description": "No game with that id."
          }
        },
        "summary": "One game's snapshot, including plays."
      }
    },
    "/api/v1/schedule": {
      "get": {
        "operationId": "getSchedule",
        "parameters": [
          {
            "description": "Day to list, as `YYYY-MM-DD`.",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "type": "string" }
          },
          {
            "description": "`1` forces an upstream refresh instead of serving the stored copy.",
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": { "enum": ["1"], "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ScheduleDayResponse" }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            },
            "description": "`date` is missing or not `YYYY-MM-DD`."
          }
        },
        "summary": "Games scheduled on one day."
      }
    }
  }
