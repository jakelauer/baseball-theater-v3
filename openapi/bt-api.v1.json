{
	"components": {
		"schemas": {
			"AbstractTeam": {
				"additionalProperties": false,
				"properties": {
					"abbreviation": { "type": "string" },
					"id": { "type": "number" },
					"name": { "type": "string" },
					"teamName": { "type": "string" }
				},
				"required": ["id", "abbreviation", "name", "teamName"],
				"type": "object"
			},
			"AccountSettings": {
				"additionalProperties": false,
				"description": "A user's settings, stored on their account (ADR-027) and synced to every device. Versioned like every BT document (ADR-022): a write applies only if its `version` is newer than the stored one, so a stale device can't undo a newer change. Controls that land later (game-row slot S67, collapse and Hide Scores S68, Video Player S70) add their fields with their reader.",
				"properties": {
					"favoriteTeamIds": {
						"description": "MLB team ids (`MLB_TEAMS`), in the order the user picked them.",
						"items": { "type": "number" },
						"type": "array"
					},
					"opensFirst": { "$ref": "#/components/schemas/OpensFirst" },
					"version": { "type": "number" }
				},
				"required": ["favoriteTeamIds", "opensFirst", "version"],
				"type": "object"
			},
			"ApiErrorResponse": {
				"additionalProperties": false,
				"description": "The one error-body shape every 4xx path returns.",
				"properties": {
					"error": { "type": "string" },
					"hint": { "type": "string" },
					"nextAllowedAt": {
						"description": "On a 429 download refusal: the ISO time the next download may be requested (`nextDownloadAllowedAt`).",
						"type": "string"
					}
				},
				"required": ["error"],
				"type": "object"
			},
			"AtBat": {
				"additionalProperties": false,
				"properties": {
					"about": {
						"additionalProperties": false,
						"properties": {
							"atBatIndex": { "type": "number" },
							"halfInning": { "enum": ["top", "bottom"], "type": "string" },
							"inning": { "type": "number" },
							"isComplete": { "type": "boolean" },
							"isScoringPlay": { "type": "boolean" }
						},
						"required": ["atBatIndex", "halfInning", "inning", "isComplete", "isScoringPlay"],
						"type": "object"
					},
					"count": {
						"additionalProperties": false,
						"properties": {
							"balls": { "type": "number" },
							"outs": { "type": "number" },
							"strikes": { "type": "number" }
						},
						"required": ["balls", "strikes", "outs"],
						"type": "object"
					},
					"matchup": {
						"additionalProperties": false,
						"properties": {
							"batSide": { "type": ["string", "null"] },
							"batter": {
								"additionalProperties": false,
								"properties": { "fullName": { "type": "string" }, "id": { "type": "number" } },
								"required": ["id", "fullName"],
								"type": "object"
							},
							"pitchHand": { "type": ["string", "null"] },
							"pitcher": {
								"additionalProperties": false,
								"properties": { "fullName": { "type": "string" }, "id": { "type": "number" } },
								"required": ["id", "fullName"],
								"type": "object"
							}
						},
						"required": ["batter", "pitcher", "batSide", "pitchHand"],
						"type": "object"
					},
					"pitches": { "items": { "$ref": "#/components/schemas/PitchEvent" }, "type": "array" },
					"result": {
						"additionalProperties": false,
						"properties": {
							"description": { "type": "string" },
							"event": { "type": "string" },
							"eventType": { "type": "string" },
							"isOut": { "type": "boolean" },
							"rbi": { "type": "number" }
						},
						"required": ["event", "description", "eventType", "isOut", "rbi"],
						"type": "object"
					}
				},
				"required": ["about", "result", "matchup", "count", "pitches"],
				"type": "object"
			},
			"BoxscoreBatter": {
				"additionalProperties": false,
				"description": "One batter's line in the box score (S2; the ratified Box frames' columns).",
				"properties": {
					"atBats": { "type": "number" },
					"avg": {
						"description": "Season batting average after this game, as MLB formats it (`.279`).",
						"type": ["string", "null"]
					},
					"baseOnBalls": { "type": "number" },
					"battingOrder": {
						"description": "MLB's batting-order code: `100`–`900` for starters, `101`… for whoever replaced them.",
						"type": "string"
					},
					"fullName": { "type": "string" },
					"hits": { "type": "number" },
					"id": { "type": "number" },
					"position": {
						"description": "Fielding position abbreviation as MLB gives it (`CF`, `DH`, `P`).",
						"type": "string"
					},
					"rbi": { "type": "number" },
					"runs": { "type": "number" },
					"strikeOuts": { "type": "number" }
				},
				"required": [
					"id",
					"fullName",
					"position",
					"battingOrder",
					"atBats",
					"runs",
					"hits",
					"rbi",
					"baseOnBalls",
					"strikeOuts",
					"avg"
				],
				"type": "object"
			},
			"BoxscoreInfoLine": {
				"additionalProperties": false,
				"description": "One `label: value` line of MLB's boxscore notes (Venue, Weather, Att…).",
				"properties": { "label": { "type": "string" }, "value": { "type": "string" } },
				"required": ["label", "value"],
				"type": "object"
			},
			"Entitlements": {
				"additionalProperties": false,
				"properties": {
					"cloudSyncedSettings": { "type": "boolean" },
					"fasterLiveRefresh": { "type": "boolean" },
					"savantLinks": { "type": "boolean" },
					"tier": { "$ref": "#/components/schemas/PatronTier" }
				},
				"required": ["tier", "fasterLiveRefresh", "cloudSyncedSettings", "savantLinks"],
				"type": "object"
			},
			"GameBoxscore": {
				"additionalProperties": false,
				"description": "The box score (S2): each team's batters in batting order, and MLB's game info lines.",
				"properties": {
					"info": { "items": { "$ref": "#/components/schemas/BoxscoreInfoLine" }, "type": "array" },
					"teams": {
						"additionalProperties": false,
						"properties": {
							"away": {
								"additionalProperties": false,
								"properties": {
									"batting": {
										"items": { "$ref": "#/components/schemas/BoxscoreBatter" },
										"type": "array"
									}
								},
								"required": ["batting"],
								"type": "object"
							},
							"home": {
								"additionalProperties": false,
								"properties": {
									"batting": {
										"items": { "$ref": "#/components/schemas/BoxscoreBatter" },
										"type": "array"
									}
								},
								"required": ["batting"],
								"type": "object"
							}
						},
						"required": ["away", "home"],
						"type": "object"
					}
				},
				"required": ["teams", "info"],
				"type": "object"
			},
			"GameRecap": {
				"additionalProperties": false,
				"description": "MLB's editorial recap as plain text (S10): the headline and the article's paragraphs, separated by blank lines. Markup, embedded players and links are stripped at ingest, so views never render outside HTML.",
				"properties": { "headline": { "type": "string" }, "text": { "type": "string" } },
				"required": ["headline", "text"],
				"type": "object"
			},
			"GameSnapshot": {
				"additionalProperties": false,
				"properties": {
					"boxscore": {
						"$ref": "#/components/schemas/GameBoxscore",
						"description": "The box score (S2); absent until MLB has one, and on older recordings."
					},
					"fetchedAt": { "type": "string" },
					"gameDate": { "type": "string" },
					"gamePk": { "type": "number" },
					"highlights": { "items": { "$ref": "#/components/schemas/MediaHighlight" }, "type": "array" },
					"lastChangedAt": {
						"description": "ISO time the content last changed — not the last poll, which is `fetchedAt`.",
						"type": "string"
					},
					"linescore": { "anyOf": [{ "$ref": "#/components/schemas/LinescoreSummary" }, { "type": "null" }] },
					"officialDate": { "type": "string" },
					"plays": { "items": { "$ref": "#/components/schemas/AtBat" }, "type": "array" },
					"recap": {
						"$ref": "#/components/schemas/GameRecap",
						"description": "MLB's editorial recap (S10); absent until MLB publishes one."
					},
					"status": {
						"additionalProperties": false,
						"properties": {
							"abstractGameState": { "type": "string" },
							"codedGameState": {
								"anyOf": [{ "$ref": "#/components/schemas/GameStatusCode" }, { "type": "string" }]
							},
							"detailedState": { "type": "string" }
						},
						"required": ["abstractGameState", "codedGameState", "detailedState"],
						"type": "object"
					},
					"teams": {
						"additionalProperties": false,
						"properties": {
							"away": { "$ref": "#/components/schemas/AbstractTeam" },
							"home": { "$ref": "#/components/schemas/AbstractTeam" }
						},
						"required": ["home", "away"],
						"type": "object"
					},
					"venue": {
						"anyOf": [
							{
								"additionalProperties": false,
								"properties": { "id": { "type": "number" }, "name": { "type": "string" } },
								"required": ["id", "name"],
								"type": "object"
							},
							{ "type": "null" }
						]
					},
					"version": {
						"description": "ADR-022: monotonic per game; bumps only when the content changes (`stampVersion`).",
						"type": "number"
					},
					"windowMode": { "enum": ["active", "cache"], "type": "string" }
				},
				"required": [
					"gamePk",
					"gameDate",
					"officialDate",
					"status",
					"teams",
					"venue",
					"linescore",
					"highlights",
					"plays",
					"fetchedAt",
					"windowMode",
					"version",
					"lastChangedAt"
				],
				"type": "object"
			},
			"GameSnapshotResponse": { "$ref": "#/components/schemas/GameSnapshot" },
			"GameStatusCode": { "enum": ["S", "P", "I", "F", "O", "C", "D", "U"], "type": "string" },
			"HitData": {
				"additionalProperties": false,
				"properties": {
					"coordinates": {
						"additionalProperties": false,
						"properties": { "coordX": { "type": "number" }, "coordY": { "type": "number" } },
						"required": ["coordX", "coordY"],
						"type": "object"
					},
					"launchAngle": { "type": "number" },
					"launchSpeed": { "type": "number" },
					"totalDistance": { "type": "number" },
					"trajectory": { "type": "string" }
				},
				"required": ["launchSpeed", "launchAngle", "totalDistance", "trajectory", "coordinates"],
				"type": "object"
			},
			"LinescoreInning": {
				"additionalProperties": false,
				"description": "One inning of the linescore (S2). A side that hasn't batted in it yet — the home half of an unfinished inning, or a bottom 9th never played — has `runs: null`.",
				"properties": {
					"away": {
						"additionalProperties": false,
						"properties": { "runs": { "type": ["number", "null"] } },
						"required": ["runs"],
						"type": "object"
					},
					"home": {
						"additionalProperties": false,
						"properties": { "runs": { "type": ["number", "null"] } },
						"required": ["runs"],
						"type": "object"
					},
					"num": { "type": "number" }
				},
				"required": ["num", "away", "home"],
				"type": "object"
			},
			"LinescoreSummary": {
				"additionalProperties": false,
				"properties": {
					"balls": { "type": ["number", "null"] },
					"currentInning": { "type": ["number", "null"] },
					"inningState": { "type": ["string", "null"] },
					"innings": {
						"description": "One entry per inning played or under way, in order (S2). Absent on older recordings.",
						"items": { "$ref": "#/components/schemas/LinescoreInning" },
						"type": "array"
					},
					"isTopInning": { "type": ["boolean", "null"] },
					"outs": { "type": ["number", "null"] },
					"scheduledInnings": {
						"description": "Innings the game is scheduled for (9 unless shortened); absent on older recordings (S2).",
						"type": ["number", "null"]
					},
					"strikes": { "type": ["number", "null"] },
					"teams": {
						"additionalProperties": false,
						"properties": {
							"away": {
								"additionalProperties": false,
								"properties": {
									"errors": { "type": ["number", "null"] },
									"hits": { "type": ["number", "null"] },
									"runs": { "type": ["number", "null"] }
								},
								"required": ["runs", "hits", "errors"],
								"type": "object"
							},
							"home": {
								"additionalProperties": false,
								"properties": {
									"errors": { "type": ["number", "null"] },
									"hits": { "type": ["number", "null"] },
									"runs": { "type": ["number", "null"] }
								},
								"required": ["runs", "hits", "errors"],
								"type": "object"
							}
						},
						"required": ["home", "away"],
						"type": "object"
					}
				},
				"required": ["currentInning", "inningState", "isTopInning", "outs", "balls", "strikes", "teams"],
				"type": "object"
			},
			"MeDeleteRequest": {
				"additionalProperties": false,
				"description": "The body of an account deletion: the phrase the user typed, which must equal  {@link  ACCOUNT_DELETION_PHRASE }  exactly. Deleting needs no download first (owner, 2026-10-27: \"Deleting and downloading aren't connected\").",
				"properties": { "phrase": { "type": "string" } },
				"required": ["phrase"],
				"type": "object"
			},
			"MeDeleteResponse": {
				"additionalProperties": false,
				"description": "A finished deletion. The session that asked no longer resolves to an account.",
				"properties": { "deleted": { "const": true, "type": "boolean" } },
				"required": ["deleted"],
				"type": "object"
			},
			"MeDownloadFileResponse": {
				"additionalProperties": false,
				"description": "A download's file: every registered personal data store's export at the time it was made.",
				"properties": {
					"expiresAt": {
						"description": "ISO time the download stops being fetchable (14 days after it was made; `downloadExpiresAt`).",
						"type": "string"
					},
					"id": { "type": "string" },
					"stores": {
						"additionalProperties": {},
						"description": "Store name (ADR-028's inventory **Where**) → that store's export; null when it held nothing.",
						"type": "object"
					}
				},
				"required": ["expiresAt", "id", "stores"],
				"type": "object"
			},
			"MeDownloadResponse": {
				"additionalProperties": false,
				"description": "A stored data download (ADR-028, owner 2026-10-27): its id and when it ages out. Requesting one answers with this, never the data; the file itself is fetched by its id, signed in, while it lasts.",
				"properties": {
					"expiresAt": {
						"description": "ISO time the download stops being fetchable (14 days after it was made; `downloadExpiresAt`).",
						"type": "string"
					},
					"id": { "type": "string" }
				},
				"required": ["id", "expiresAt"],
				"type": "object"
			},
			"MeResponse": {
				"additionalProperties": false,
				"description": "The signed-in account, for Settings' \"Signed in as {email}\" (standings-search-settings A3) and for gating UI by entitlement. A projection of `UserProfile`, not the whole record: Patreon IDs and timestamps stay server-side.",
				"properties": {
					"email": {
						"description": "Every account has an email (owner, 2026-10-28: \"It should be impossible for an account to have no email.\"; S82).",
						"type": "string"
					},
					"entitlements": { "$ref": "#/components/schemas/Entitlements" },
					"role": { "$ref": "#/components/schemas/Role" },
					"uid": { "type": "string" }
				},
				"required": ["uid", "email", "role", "entitlements"],
				"type": "object"
			},
			"MediaHighlight": {
				"additionalProperties": false,
				"properties": {
					"blurb": { "type": ["string", "null"] },
					"duration": { "type": ["string", "null"] },
					"id": { "type": "string" },
					"imageUrl": { "type": ["string", "null"] },
					"playId": { "type": ["string", "null"] },
					"playbackUrl": { "type": ["string", "null"] },
					"title": { "type": "string" }
				},
				"required": ["id", "playId", "title", "blurb", "duration", "imageUrl", "playbackUrl"],
				"type": "object"
			},
			"OpensFirst": { "enum": ["videos", "live", "box"], "type": "string" },
			"PatronTier": {
				"enum": ["none", "Backer", "Pro Backer", "Star Backer", "Premium Sponsor"],
				"type": "string"
			},
			"PitchBreaks": {
				"additionalProperties": false,
				"properties": {
					"breakAngle": { "type": "number" },
					"breakLength": { "type": "number" },
					"spinRate": { "type": "number" }
				},
				"required": ["breakAngle", "breakLength", "spinRate"],
				"type": "object"
			},
			"PitchData": {
				"additionalProperties": false,
				"properties": {
					"breaks": { "anyOf": [{ "$ref": "#/components/schemas/PitchBreaks" }, { "type": "null" }] },
					"coordinates": { "$ref": "#/components/schemas/PitchKinematics" },
					"endSpeed": { "type": "number" },
					"extension": { "type": ["number", "null"] },
					"plateTime": { "type": ["number", "null"] },
					"startSpeed": { "type": "number" },
					"strikeZoneBottom": { "type": "number" },
					"strikeZoneTop": { "type": "number" },
					"zone": { "type": ["number", "null"] }
				},
				"required": [
					"startSpeed",
					"endSpeed",
					"strikeZoneTop",
					"strikeZoneBottom",
					"zone",
					"plateTime",
					"extension",
					"coordinates",
					"breaks"
				],
				"type": "object"
			},
			"PitchEvent": {
				"additionalProperties": false,
				"properties": {
					"count": {
						"additionalProperties": false,
						"properties": {
							"balls": { "type": "number" },
							"outs": { "type": "number" },
							"strikes": { "type": "number" }
						},
						"required": ["balls", "strikes", "outs"],
						"type": "object"
					},
					"details": {
						"additionalProperties": false,
						"properties": {
							"ballColor": { "type": ["string", "null"] },
							"call": { "type": ["string", "null"] },
							"callDescription": { "type": ["string", "null"] },
							"isBall": { "type": "boolean" },
							"isInPlay": { "type": "boolean" },
							"isStrike": { "type": "boolean" },
							"type": { "type": ["string", "null"] },
							"typeDescription": { "type": ["string", "null"] }
						},
						"required": [
							"call",
							"callDescription",
							"type",
							"typeDescription",
							"isBall",
							"isStrike",
							"isInPlay",
							"ballColor"
						],
						"type": "object"
					},
					"hitData": { "anyOf": [{ "$ref": "#/components/schemas/HitData" }, { "type": "null" }] },
					"pitchData": { "anyOf": [{ "$ref": "#/components/schemas/PitchData" }, { "type": "null" }] },
					"pitchNumber": { "type": "number" },
					"playId": { "type": "string" },
					"startTime": { "type": "string" }
				},
				"required": ["pitchNumber", "playId", "startTime", "details", "count", "pitchData", "hitData"],
				"type": "object"
			},
			"PitchKinematics": {
				"additionalProperties": false,
				"properties": {
					"ax": { "type": "number" },
					"ay": { "type": "number" },
					"az": { "type": "number" },
					"pX": { "type": "number" },
					"pZ": { "type": "number" },
					"pfxX": { "type": "number" },
					"pfxZ": { "type": "number" },
					"vx0": { "type": "number" },
					"vy0": { "type": "number" },
					"vz0": { "type": "number" },
					"x0": { "type": "number" },
					"y0": { "type": "number" },
					"z0": { "type": "number" }
				},
				"required": ["pX", "pZ", "x0", "y0", "z0", "vx0", "vy0", "vz0", "ax", "ay", "az", "pfxX", "pfxZ"],
				"type": "object"
			},
			"Role": {
				"description": "What a user may administer. Lives in BT, not the identity provider (ADR-019: no provider RBAC).",
				"enum": ["member", "admin"],
				"type": "string"
			},
			"ScheduleDay": {
				"additionalProperties": false,
				"properties": {
					"date": { "type": "string" },
					"fetchedAt": { "type": "string" },
					"games": { "items": { "$ref": "#/components/schemas/ScheduleGameSummary" }, "type": "array" },
					"lastChangedAt": {
						"description": "ISO time the content last changed — not the last poll, which is `fetchedAt`.",
						"type": "string"
					},
					"version": {
						"description": "ADR-022: monotonic per day; bumps only when the content changes (`stampVersion`).",
						"type": "number"
					},
					"windowMode": { "enum": ["active", "cache"], "type": "string" }
				},
				"required": ["date", "games", "fetchedAt", "windowMode", "version", "lastChangedAt"],
				"type": "object"
			},
			"ScheduleDayResponse": { "$ref": "#/components/schemas/ScheduleDay" },
			"ScheduleGameSummary": {
				"additionalProperties": false,
				"properties": {
					"gameDate": { "type": "string" },
					"gamePk": { "type": "number" },
					"linescore": { "anyOf": [{ "$ref": "#/components/schemas/LinescoreSummary" }, { "type": "null" }] },
					"officialDate": { "type": "string" },
					"status": {
						"additionalProperties": false,
						"properties": {
							"abstractGameState": { "type": "string" },
							"codedGameState": {
								"anyOf": [{ "$ref": "#/components/schemas/GameStatusCode" }, { "type": "string" }]
							},
							"detailedState": { "type": "string" }
						},
						"required": ["abstractGameState", "codedGameState", "detailedState"],
						"type": "object"
					},
					"teams": {
						"additionalProperties": false,
						"properties": {
							"away": { "$ref": "#/components/schemas/AbstractTeam" },
							"home": { "$ref": "#/components/schemas/AbstractTeam" }
						},
						"required": ["home", "away"],
						"type": "object"
					},
					"venue": {
						"anyOf": [
							{
								"additionalProperties": false,
								"properties": { "id": { "type": "number" }, "name": { "type": "string" } },
								"required": ["id", "name"],
								"type": "object"
							},
							{ "type": "null" }
						]
					}
				},
				"required": ["gamePk", "gameDate", "officialDate", "status", "teams", "venue", "linescore"],
				"type": "object"
			},
			"SettingsRequest": {
				"$ref": "#/components/schemas/AccountSettings",
				"description": "A settings write: the whole document with a bumped `version`; an older version is ignored (ADR-022)."
			},
			"SettingsResponse": {
				"$ref": "#/components/schemas/AccountSettings",
				"description": "The signed-in user's settings document (ADR-027); the house defaults until they first save."
			}
		}
	},
	"info": {
		"description": "Generated from the typed route table in packages/domain/src/api-routes.ts by `pnpm api:spec`. Do not edit by hand.",
		"title": "Baseball Theater API",
		"version": "v1"
	},
	"openapi": "3.1.0",
	"paths": {
		"/api/v1/games/{gamePk}": {
			"get": {
				"operationId": "getGame",
				"parameters": [
					{
						"description": "MLB game id.",
						"in": "path",
						"name": "gamePk",
						"required": true,
						"schema": { "type": "integer" }
					},
					{
						"description": "`1` forces an upstream refresh instead of serving the stored copy.",
						"in": "query",
						"name": "refresh",
						"required": false,
						"schema": { "enum": ["1"], "type": "string" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/GameSnapshotResponse" } }
						},
						"description": "OK"
					},
					"404": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No game with that id."
					}
				},
				"summary": "One game's snapshot, including plays."
			}
		},
		"/api/v1/me": {
			"get": {
				"operationId": "getMe",
				"parameters": [],
				"responses": {
					"200": {
						"content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } },
						"description": "OK"
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or an invalid or expired one: the caller is signed out. `account_deleted` (once): the request carries the deletion cookie a successful `POST /api/v1/me/delete` set, so the account is gone; this response clears it, as does any `/me` response that sees it (S87)."
					}
				},
				"summary": "The signed-in account. Send the BT session as `Authorization: Bearer <token>`."
			}
		},
		"/api/v1/me/delete": {
			"post": {
				"operationId": "deleteMe",
				"parameters": [],
				"requestBody": {
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeDeleteRequest" } } },
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/MeDeleteResponse" } }
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "The body is not JSON with `phrase`, or the phrase is not the confirmation phrase exactly."
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or the account no longer exists."
					},
					"403": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "`reauth_required`: the sign-in is older than 10 minutes."
					}
				},
				"summary": "Deletes the signed-in user's data from every store, stored downloads included, immediately. Needs a sign-in from the last 10 minutes and the exact confirmation phrase; no download is required."
			}
		},
		"/api/v1/me/download": {
			"get": {
				"operationId": "getCurrentDownload",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/MeDownloadResponse" } }
						},
						"description": "OK"
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or the account no longer exists."
					},
					"404": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No download, or the last one has aged out."
					}
				},
				"summary": "The signed-in user's newest download that hasn't aged out: its id and expiry."
			},
			"post": {
				"operationId": "requestDownload",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/MeDownloadResponse" } }
						},
						"description": "OK"
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or the account no longer exists."
					},
					"429": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "`download_limit`: two downloads were requested in the last 24 hours; `nextAllowedAt` says when the next is allowed."
					}
				},
				"summary": "Makes a download of everything BT keeps about the signed-in user and emails them a link to Settings. Answers with the download's id and expiry (14 days on), not the data. At most two in any rolling 24 hours (ADR-028)."
			}
		},
		"/api/v1/me/download/{downloadId}": {
			"get": {
				"operationId": "getDownloadFile",
				"parameters": [
					{
						"description": "The id a download request answered with.",
						"in": "path",
						"name": "downloadId",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/MeDownloadFileResponse" } }
						},
						"description": "OK"
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or the account no longer exists."
					},
					"404": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No such download of this user's, or it has aged out."
					}
				},
				"summary": "One download's file: every registered store's export, keyed by store, as it was when the download was made. Its owner only."
			}
		},
		"/api/v1/me/settings": {
			"get": {
				"operationId": "getSettings",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/SettingsResponse" } }
						},
						"description": "OK"
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or the account no longer exists."
					}
				},
				"summary": "The signed-in user's settings; the house defaults (version 0) until they first save."
			},
			"put": {
				"operationId": "putSettings",
				"parameters": [],
				"requestBody": {
					"content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingsRequest" } } },
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/SettingsResponse" } }
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "The body is not a settings document (known team ids, an offered room, a whole non-negative version)."
					},
					"401": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "No session, or the account no longer exists."
					}
				},
				"summary": "Saves the whole settings document. Applies only if `version` is newer than the stored one (ADR-022); answers with what is stored either way."
			}
		},
		"/api/v1/schedule": {
			"get": {
				"operationId": "getSchedule",
				"parameters": [
					{
						"description": "Day to list, as `YYYY-MM-DD`.",
						"in": "query",
						"name": "date",
						"required": true,
						"schema": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "type": "string" }
					},
					{
						"description": "`1` forces an upstream refresh instead of serving the stored copy.",
						"in": "query",
						"name": "refresh",
						"required": false,
						"schema": { "enum": ["1"], "type": "string" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ScheduleDayResponse" } }
						},
						"description": "OK"
					},
					"400": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
						},
						"description": "`date` is missing or not `YYYY-MM-DD`."
					}
				},
				"summary": "Games scheduled on one day."
			}
		}
	}
}
