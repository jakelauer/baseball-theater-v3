{
	"name": "baseball-theater-v3",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "concurrently -n api,web -c blue,green \"pnpm --filter @bt/functions dev\" \"pnpm --filter @bt/web dev\"",
		"build": "pnpm lint && pnpm typecheck && pnpm -r --filter=!baseball-theater-v3 run build",
		"typecheck": "pnpm -r --filter=!baseball-theater-v3 run typecheck",
		"lint": "pnpm backlog:check && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:coverage": "pnpm -r --filter=!baseball-theater-v3 run test:coverage && pnpm test:backlog && pnpm test:tools",
		"test:watch": "vitest",
		"test:backlog": "vitest run --config scripts/backlog-vault/vitest.config.ts",
		"test:tools": "vitest run --config tools/vitest.config.js",
		"dup:check": "jscpd --config .jscpd.json",
		"comments:stale": "node tools/comments-stale/comments-stale.js",
		"verify": "pnpm lint && pnpm dup:check && pnpm test:coverage && pnpm build && pnpm size",
		"mlb:scan-drift": "pnpm --filter @bt/functions exec tsx src/scripts/scan-drift.ts",
		"api:spec": "pnpm --filter @bt/functions exec tsx src/scripts/generate-openapi.ts",
		"api:breaking": "pnpm --filter @bt/functions exec tsx src/scripts/api-breaking.ts",
		"api:types": "pnpm --filter @bt/web api:types",
		"backlog:build": "node scripts/backlog-vault/cli.ts build",
		"backlog:check": "node scripts/backlog-vault/cli.ts check",
		"backlog:import": "node scripts/backlog-vault/cli.ts import",
		"parity:debt": "scripts/parity-debt.sh",
		"goal": "scripts/goal.sh",
		"prepare": "husky",
		"size": "size-limit --json"
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"@size-limit/file": "^14.2.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^22.13.10",
		"@vitest/coverage-v8": "^3.0.8",
		"concurrently": "^9.1.2",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"eslint-plugin-require-extensions": "^0.1.3",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jscpd": "^5.4.1",
		"lint-staged": "^15.5.0",
		"only-allow": "^1.2.1",
		"prettier": "^3.5.3",
		"size-limit": "^14.2.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vitest": "^3.0.8",
		"yaml": "^2.9.0"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"eslint --fix"
		],
		"*.{json,md,yml,yaml,css,scss,html}": [
			"prettier --write"
		]
	}
}
