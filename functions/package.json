{
  "name": "@bt/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "start": "tsx src/local-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "record-fixtures": "tsx src/scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@bt/domain": "workspace:*",
    "@bt/mlb-api": "workspace:*",
    "@bt/ports": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
